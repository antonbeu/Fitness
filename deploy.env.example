# Kopieren nach deploy.env und ausfüllen (deploy.env nie ins Git!).

# Starkes, zufälliges Datenbank-Passwort, z. B.: openssl rand -hex 24
POSTGRES_PASSWORD=

# Geheimer Schlüssel für Logins, z. B.: openssl rand -base64 32
AUTH_SECRET=

# Öffentliche Adresse der App, mit https:// und ohne Schrägstrich am Ende
AUTH_URL=https://training.example.de

# Dieselbe Domain ohne https:// (für Caddy)
DOMAIN=training.example.de
